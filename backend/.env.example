# 环境变量模板：所有真实密钥只写入本目录的 .env（已 gitignore，绝不提交），
# 本文件仅提供字段结构与占位符。

# ===== 大模型（DeepSeek，OpenAI 兼容）=====
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
APP_ENV=development

# ===== 科大讯飞 WebSocket 语音听写 v2（首选云端引擎）=====
# 控制台：https://console.xfyun.cn 服务：语音听写（流式版）
XF_ASR_APP_ID=replace_me
XF_ASR_API_SECRET=replace_me
XF_ASR_API_KEY=replace_me

# ===== 科大讯飞 录音文件转写（HTTP，备用，可不填）=====
KDXF_ASR_APP_ID=replace_me
KDXF_ASR_ACCESS_KEY_ID=replace_me
KDXF_ASR_ACCESS_KEY_SECRET=replace_me
KDXF_ASR_BASE_URL=https://office-api-ist-dx.iflyaisol.com
KDXF_ASR_LANGUAGE=autodialect
KDXF_ASR_POLL_INTERVAL_SECONDS=5
KDXF_ASR_POLL_TIMEOUT_SECONDS=900
