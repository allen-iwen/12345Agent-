# 环境变量模板：所有真实密钥只写入本目录的 .env（已 gitignore，绝不提交），
# 本文件仅提供字段结构与占位符。

# ===== 大模型（DeepSeek，OpenAI 兼容）=====
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
APP_ENV=development

# ===== 本地实验模型（vLLM 部署，token 不限，用于开发调试）=====
# 实验时把上面三行换成（保持本文件只放占位符，真实切换写 .env）：
#   LLM_API_KEY=EMPTY
#   LLM_BASE_URL=http://192.168.1.231:30001/v1
#   LLM_MODEL=Qwen3.8-27B
#   LLM_DISABLE_THINKING=true    # 关闭 Qwen 内置思考链（chat_template_kwargs）
#   LLM_JSON_MODE=false          # 本地 vLLM 不支持 response_format 时置 false
LLM_JSON_MODE=true
LLM_DISABLE_THINKING=false

# ===== 运营商/呼叫中心对接（真实政务热线接入，详见 docs/telephony.md）=====
# TELEPHONY_PROVIDER=generic          # generic=回调/目录投递；sip=FreeSWITCH 规划位
# TELEPHONY_WEBHOOK_SECRET=           # 回调鉴权密钥，生产必配；留空=放行并告警（仅联调）
# TELEPHONY_RECORDING_DIR=            # 录音投递目录，默认 storage/telephony_recordings

# ===== 科大讯飞 WebSocket 语音听写 v2（首选云端引擎）=====
# 控制台：https://console.xfyun.cn 服务：语音听写（流式版）
XF_ASR_APP_ID=replace_me
XF_ASR_API_SECRET=replace_me
XF_ASR_API_KEY=replace_me

# ===== 科大讯飞 录音文件转写（HTTP，备用，可不填）=====
KDXF_ASR_APP_ID=replace_me
KDXF_ASR_ACCESS_KEY_ID=replace_me
KDXF_ASR_ACCESS_KEY_SECRET=replace_me
KDXF_ASR_BASE_URL=https://office-api-ist-dx.iflyaisol.com
KDXF_ASR_LANGUAGE=autodialect
KDXF_ASR_POLL_INTERVAL_SECONDS=5
KDXF_ASR_POLL_TIMEOUT_SECONDS=900

# ===== 多模态视觉（图片证据受理）=====
# MiniMax OpenAI 兼容接口（视觉模型 MiniMax-M3，图片 ≤10MB，支持 Base64 data URL）
# 验证可用性：python scripts/verify_vision.py
VISION_PROVIDER=none                       # none | minimax | qianfan
VISION_BASE_URL=https://api.minimaxi.com/v1   # 国际站：https://api.minimax.io/v1
VISION_API_KEY=replace_me
VISION_MODEL=MiniMax-M3
# 备用 provider（主 provider 不可用时自动降级；千帆 ERNIE-4.5-VL 同为 OpenAI 兼容）
VISION_FALLBACK_PROVIDER=                  # qianfan
VISION_FALLBACK_BASE_URL=https://qianfan.baidubce.com/v2
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=

# ===== 第二模型交叉复核（默认关闭；评测与演示开启）=====
LLM_REVIEW_ENABLED=false
LLM_REVIEW_MODEL=
LLM_REVIEW_BASE_URL=
LLM_REVIEW_API_KEY=

# ===== 轻量 RBAC 与审计（默认关闭；演示开启）=====
RBAC_ENABLED=false
# SESSION_SECRET=            # 留空则启动生成临时密钥并告警
# SESSION_TTL_HOURS=12
